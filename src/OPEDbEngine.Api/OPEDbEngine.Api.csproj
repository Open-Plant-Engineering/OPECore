<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OPEDbEngine.Application\OPEDbEngine.Application.csproj" />
    <ProjectReference Include="..\OPEDbEngine.Infrastructure\OPEDbEngine.Infrastructure.csproj" />
    <ProjectReference Include="..\OPEDbEngine.Contracts\OPEDbEngine.Contracts.csproj" />
	<Protobuf Include="..\OPEDbEngine.Contracts\Protos\health.proto" GrpcServices="Server" />
